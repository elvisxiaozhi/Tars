{
    "polymarket": {
        "clob_rest_url": "https://clob.polymarket.com",
        "clob_ws_url": "wss://ws-subscriptions-clob.polymarket.com/ws/market",
        "gamma_api_url": "https://gamma-api.polymarket.com",
        "chain_id": 137,
        "_comment": "live 模式必填：proxy_address 在 polymarket.com Deposit 页能看到；api_address 在 Profile Settings 页",
        "proxy_address": "",
        "api_address": ""
    },

    "strategy": {
        "mode": "dry_run",
        "account_balance": 20.0,
        "poll_interval_sec": 5,
        "min_net_profit_pct": 0.5,
        "max_trade_size_usdc": 100.0,
        "arb_types": ["complement", "multi_outcome"],
        "min_liquidity_usdc": 500.0,
        "min_volume_24h": 1000.0,
        "max_markets_to_scan": 100,
        "market_filter": "btc-updown",
        "crypto_symbols": ["BTC", "ETH", "SOL", "XRP", "DOGE", "BNB"],
        "quiet_reversion_enabled": false
    },

    "experiment": {
        "enabled": true,
        "strategy": "regime",
        "initial_balance": 20.0
    },

    "risk": {
        "max_position_per_market": 500.0,
        "max_total_exposure": 2000.0,
        "max_single_trade": 100.0,
        "daily_loss_limit": 50.0,
        "max_open_orders": 10,
        "kill_switch": false
    },

    "logging": {
        "level": "info",
        "file": "./logs/bot.log",
        "console": true
    },

    "network": {
        "proxy_url": "",
        "api_host": "127.0.0.1",
        "api_port": 5819
    },

    "wallet": {
        "keystore_path": "./keystore.enc",
        "address": ""
    },

    "fees": {
        "maker_fee_rate": 0.0,
        "taker_fee_rate": 0.07,
        "finance_taker_fee_rate": 0.04,
        "gas_per_tx_usdc": 0.0,
        "min_order_usdc": 1.0,
        "min_order_shares": 5.0
    },

    "polygon": {
        "_comment": "rpc_urls 留空 = 用代码内置默认（publicnode + drpc + 1rpc，按顺序 failover）；合约地址默认 = Polymarket 主网值，无需改",
        "rpc_urls": [],
        "chain_id": 137
    }
}
